# এই ফাইলটা কপি করে .env নাম দাও, তারপর মান বসাও। .env কখনো git-এ যাবে না।

# Neon থেকে পাওয়া PostgreSQL connection string (খালি রাখলে DB ছাড়াই চলবে)
# ⚠️ লোকালে production DB না দিয়ে Neon-এর আলাদা "dev" branch-এর URL দাও
DATABASE_URL=

# Web কোথা থেকে API কল করবে (কমা দিয়ে একাধিক)
WEB_ORIGIN=http://localhost:3000
# ইউজার যে ঠিকানায় সাইট খোলে (Google লগইনের redirect এখানে ফেরে)
PUBLIC_WEB_URL=http://localhost:3000

PORT=4000

# Judge worker-দের গোপন টোকেন (apps/judge/.env-এও একই মান)
JUDGE_TOKEN=

# এই ইমেইলগুলো দিয়ে লগইন করলে ADMIN হবে (কমা দিয়ে একাধিক)
ADMIN_EMAILS=

# Google লগইন (Google Cloud Console → OAuth client)। খালি থাকলে বাটন দেখাবে না।
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

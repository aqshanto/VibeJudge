// VibeJudge database schema
// ফেজ ১খ: User, Problem, TestCase, Submission — কনটেস্টের টেবিল ফেজ ৩-এ যোগ হবে।

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  AUTHOR
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique // সবসময় lowercase
  username     String   @unique // সবসময় lowercase: a-z, 0-9, _ . -
  displayName  String?
  passwordHash String? // শুধু Google দিয়ে খোলা অ্যাকাউন্টে null
  googleId     String?  @unique
  role         Role     @default(USER)
  institution  String?
  batch        String?
  section      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  problems         Problem[]
  submissions      Submission[]
  sessions         Session[]
  authorRequests   AuthorRequest[]      @relation("requester")
  reviewedRequests AuthorRequest[]      @relation("reviewer")
  contests         Contest[]
  participations   ContestParticipant[]
  clarifications   Clarification[]      @relation("asker")
  teamMemberships  TeamMember[]
  teamsCreated     Team[]               @relation("teamCreator")

  @@map("users")
}

// ---------------- Teams ----------------

/// স্থায়ী টিম — একবার বানিয়ে বিভিন্ন team contest-এ রেজিস্টার করা যায়
model Team {
  id             String               @id @default(cuid())
  /// URL-এর জন্য (a-z, 0-9, -)
  slug           String               @unique
  name           String
  /// ছোট হাতের নাম — একই নামের দুটো টিম যেন না হয় (বড়/ছোট হাতের তফাত বাদে)
  nameKey        String               @unique
  createdById    String?
  createdBy      User?                @relation("teamCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())
  members        TeamMember[]
  participations ContestParticipant[]

  @@map("teams")
}

enum TeamRole {
  OWNER // সদস্য invite/বাদ দিতে পারে
  MEMBER
}

model TeamMember {
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      TeamRole @default(MEMBER)
  /// false = invite পাঠানো হয়েছে, এখনো Accept করেনি
  accepted  Boolean  @default(false)
  invitedAt DateTime @default(now())

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

/// লগইন session। কুকিতে random টোকেন থাকে, DB-তে শুধু তার SHA-256 hash।
model Session {
  id        String   @id // sha256(token), hex
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

enum AuthorRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model AuthorRequest {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation("requester", fields: [userId], references: [id], onDelete: Cascade)
  message      String
  status       AuthorRequestStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?               @relation("reviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())

  @@index([status, createdAt])
  @@index([userId])
  @@map("author_requests")
}

enum Visibility {
  PRIVATE // শুধু author
  CONTEST // শুধু কনটেস্টের ভেতরে
  PUBLIC // Problem Archive-এ সবার জন্য
}

enum Language {
  c
  cpp
  java
  python
}

enum Verdict {
  PENDING
  JUDGING
  AC
  WA
  TLE
  MLE
  RE
  CE
  IE
}

model Problem {
  id            String     @id @default(cuid())
  slug          String     @unique
  title         String
  statement     String // Markdown + LaTeX
  timeLimitMs   Int        @default(1000)
  memoryLimitKb Int        @default(262144)
  /// testlib checker-এর C++ সোর্স; null হলে token compare
  checkerSource String?
  visibility    Visibility @default(PRIVATE)
  /// টেস্ট বা checker বদলালে বাড়ে — worker তখন cache ফেলে নতুন ডাটা নামায়
  dataVersion   Int        @default(1)
  authorId      String?
  author        User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tests           TestCase[]
  submissions     Submission[]
  contestProblems ContestProblem[]

  @@map("problems")
}

/// ছোট টেস্ট আপাতত DB-তে থাকে; ফেজ ২-এ বড় টেস্টের জন্য Cloudflare R2-তে সরবে।
/// Worker সবসময় API দিয়ে নামায়, তাই স্টোরেজ বদলালেও worker বদলাতে হবে না।
model TestCase {
  id        String  @id @default(cuid())
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  ordinal   Int
  input     Bytes
  answer    Bytes
  isSample  Boolean @default(false)

  @@unique([problemId, ordinal])
  @@map("test_cases")
}

model Submission {
  id            String    @id @default(cuid())
  problemId     String
  problem       Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  userId        String? // ফেজ ২-এ লগইন বাধ্যতামূলক হবে
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  language      Language
  source        String
  verdict       Verdict   @default(PENDING)
  timeMs        Int?
  memoryKb      Int?
  compileOutput String?
  /// প্রতিটা টেস্টের ফলাফল: [{ name, verdict, timeMs, memoryKb, message }]
  testResults   Json?
  /// কোন worker নিয়েছে, আর claim-এর গোপন টোকেন (অন্য কেউ রেজাল্ট লিখতে পারবে না)
  workerName    String?
  claimToken    String?
  claimedAt     DateTime?
  judgedAt      DateTime?
  createdAt     DateTime  @default(now())

  /// কনটেস্টের ভেতর থেকে করা হলে
  contestId String?
  contest   Contest? @relation(fields: [contestId], references: [id], onDelete: SetNull)
  /// কনটেস্ট চলাকালীন রেজিস্টার করা প্রতিযোগীর সাবমিশন — শুধু এগুলোই standings-এ গোনা হয়
  /// (কনটেস্টের পরে করা = upsolve, false)
  inContest Boolean  @default(false)
  /// IOI: পাস করা টেস্ট ÷ মোট টেস্ট × ১০০
  score     Int?

  @@index([verdict, createdAt])
  @@index([problemId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt]) // সব সাবমিশনের তালিকা (নতুনগুলো আগে)
  @@index([contestId, createdAt])
  @@map("submissions")
}

// ---------------- Contests ----------------

enum ContestType {
  FIXED // সবাই একসাথে
  WINDOW // জানালার মধ্যে প্রত্যেকে নিজের সময়ে শুরু করে
}

enum ScoringType {
  ICPC // সলভ সংখ্যা + penalty
  IOI // আংশিক নম্বর (পাস করা টেস্টের অনুপাতে)
}

model Contest {
  id              String      @id @default(cuid())
  slug            String      @unique
  title           String
  description     String      @default("") // Markdown
  /// WINDOW-এ: জানালা খোলার সময়
  startsAt        DateTime
  /// WINDOW-এ: প্রত্যেক প্রতিযোগী কত মিনিট পায়
  durationMinutes Int
  /// FIXED: startsAt + durationMinutes; WINDOW: জানালা বন্ধের সময়।
  /// সেভের সময় হিসাব হয়, query-তে "শেষ হয়েছে কি না" দেখতে লাগে
  endsAt          DateTime
  scoring         ScoringType @default(ICPC)
  type            ContestType @default(FIXED)
  /// null = একক কনটেস্ট; সংখ্যা = team contest, প্রতি টিমে সর্বোচ্চ এতজন
  teamSize        Int?
  /// ICPC: প্রতিটা ভুল সাবমিশনে কত মিনিট (CE বাদে)
  penaltyMinutes  Int         @default(20)
  /// শেষের এত মিনিট standings লুকানো থাকে (০ = freeze নেই); কনটেস্ট শেষে নিজে থেকে খুলে যায়
  freezeMinutes   Int         @default(0)
  /// false হলে কনটেস্টের তালিকায় দেখায় না, আর রেজিস্টার করতে পাসওয়ার্ড লাগে
  isPublic        Boolean     @default(true)
  passwordHash    String?
  /// কোন ভাষায় সাবমিট করা যাবে (নতুন কনটেস্টে C/C++; author বাকিগুলো চালু করেন)
  languages       Language[]  @default([c, cpp])
  authorId        String?
  author          User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  problems       ContestProblem[]
  participants   ContestParticipant[]
  submissions    Submission[]
  clarifications Clarification[]
  announcements  Announcement[]

  @@index([startsAt])
  @@index([endsAt])
  @@map("contests")
}

model ContestProblem {
  contestId String
  contest   Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  /// "A", "B", ...
  label     String

  @@id([contestId, problemId])
  @@unique([contestId, label])
  @@map("contest_problems")
}

/// পরে Team যোগ হলে এখানে teamId আসবে
model ContestParticipant {
  contestId    String
  contest      Contest   @relation(fields: [contestId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  registeredAt DateTime  @default(now())
  /// WINDOW বা virtual-এ "Start" চাপার সময় (FIXED-এ null)
  startedAt    DateTime?
  /// কনটেস্ট শেষ হওয়ার পরে নিজে নিজে দেওয়া — standings-এ আলাদা চিহ্ন, আসলদের rank বদলায় না
  virtual      Boolean   @default(false)
  /// team contest-এ কোন টিমের হয়ে (রেজিস্ট্রেশনের সময়ের সদস্যরা — পরে টিম বদলালেও এটা বদলায় না)
  teamId       String?
  team         Team?     @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@id([contestId, userId])
  @@index([userId])
  @@index([teamId])
  @@map("contest_participants")
}

model Clarification {
  id         String    @id @default(cuid())
  contestId  String
  contest    Contest   @relation(fields: [contestId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation("asker", fields: [userId], references: [id], onDelete: Cascade)
  /// কোন প্রবলেম নিয়ে প্রশ্ন ("A", "B" … বা null = সাধারণ)
  label      String?
  question   String
  answer     String?
  /// true হলে সব প্রতিযোগী উত্তরটা দেখে
  isPublic   Boolean   @default(false)
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([contestId, createdAt])
  @@map("clarifications")
}

model Announcement {
  id        String   @id @default(cuid())
  contestId String
  contest   Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())

  @@index([contestId, createdAt])
  @@map("announcements")
}

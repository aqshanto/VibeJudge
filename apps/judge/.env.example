# এই ফাইলটা কপি করে .env নাম দাও। .env কখনো git-এ যাবে না।

# API কোথায় চলছে। লোকাল API হলে Docker-এর ভেতর থেকে host.docker.internal দিয়ে যেতে হয়।
API_URL=http://host.docker.internal:4000

# apps/api/.env (বা Render)-এর JUDGE_TOKEN-এর সাথে হুবহু এক হতে হবে
JUDGE_TOKEN=

# একসাথে কয়টা সাবমিশন judge হবে (ডিফল্ট: CPU সংখ্যা - 1)
CONCURRENCY=2

# isolate configuration (installed as /usr/local/etc/isolate)

# সব sandbox এখানে তৈরি হয়
box_root = /var/local/lib/isolate
lock_root = /run/isolate/locks

# Docker-এ systemd নেই, তাই entrypoint.sh নিজে এই cgroup বানিয়ে দেয়
cg_root = /sys/fs/cgroup/isolate

# প্রতিটা box আলাদা UID/GID পায় (60000, 60001, ...)
first_uid = 60000
first_gid = 60000
num_boxes = 1000

{
  "name": "vibejudge",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @vibejudge/shared build && pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @vibejudge/web dev",
    "dev:api": "pnpm --filter @vibejudge/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "judge:build": "docker build -f apps/judge/Dockerfile -t vibejudge-judge .",
    "judge:selftest": "docker run --rm --privileged --cgroupns=private -v ./apps/judge/fixtures:/fixtures:ro vibejudge-judge node dist/selftest.js /fixtures",
    "judge:worker": "docker run --rm --name vj-worker --privileged --cgroupns=private --env-file apps/judge/.env vibejudge-judge",
    "judge:e2e": "node apps/judge/scripts/e2e.mjs"
  }
}
